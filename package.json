{
  "name": "twocal",
  "version": "0.1.1",
  "type": "module",
  "description": "Ultra-modern, framework-agnostic date range picker",
  "main": "./dist/twocal.umd.cjs",
  "module": "./dist/twocal.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/twocal.js",
      "require": "./dist/twocal.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "prepublishOnly": "npm run lint && npm run test:run && npm run build"
  },
  "author": "Sergio Bayona",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergiobayona/twocal.git"
  },
  "homepage": "https://github.com/sergiobayona/twocal#readme",
  "bugs": {
    "url": "https://github.com/sergiobayona/twocal/issues"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0",
    "jsdom": "^25.0.0",
    "@vitest/coverage-v8": "^3.0.0"
  },
  "keywords": [
    "datepicker",
    "daterange",
    "date-range-picker",
    "vanilla-js",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
